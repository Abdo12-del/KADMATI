{
  "name": "aurova-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Aurova Studio — a professional presentation design platform (RTL-first, PPTX round-trip)",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icons:generate": "node scripts/gen-icon-set.mjs",
    "assets:hands": "node scripts/build-hand-assets.mjs",
    "test": "npm run typecheck && npm run test:unit && npm run test:anim && npm run test:pdf && npm run test:model && npm run test:zoom && npm run test:openslide",
    "test:unit": "node tests/document/build.mjs && node tests/document/sanitize.test.mjs",
    "test:anim": "node tests/animations/verify.mjs",
    "test:pdf": "node tests/pdf/fixtures.mjs && node tests/pdf/build.mjs && node .tmp-verify/pdf-test.mjs",
    "test:pdf:fixtures": "node tests/pdf/fixtures.mjs",
    "gateway": "node server/aurova-gateway.mjs",
    "model:dataset": "node model/build.mjs",
    "model:distill": "node model/distill.mjs",
    "model:eval": "node model/eval.mjs",
    "model:eval:stub": "node model/eval.mjs --url http://127.0.0.1:8787/v1/chat/completions --model aurova-deck-1",
    "test:model": "node model/smoke.mjs",
    "test:zoom": "node tests/zoom/build.mjs && node tests/zoom/verify.mjs",
    "test:openslide": "node tests/open-slide/build.mjs && node tests/open-slide/verify.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.12",
    "animejs": "^4.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "html-to-image": "1.11.13",
    "idb": "8.0.3",
    "immer": "11.1.18",
    "jszip": "3.10.2",
    "lucide": "^0.544.0",
    "lucide-react": "1.45.0",
    "nanoid": "5.1.16",
    "pdfjs-dist": "^6.3.289",
    "pptxgenjs": "4.0.1",
    "pptxtojson": "2.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "recharts": "3.10.1",
    "roughjs": "^4.6.6",
    "tailwind-merge": "3.7.0",
    "tesseract.js": "^7.0.0",
    "zundo": "2.3.0",
    "zustand": "5.0.15"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "pdfkit": "^0.20.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vazirmatn": "^33.0.3",
    "vite": "8.3.0"
  }
}
